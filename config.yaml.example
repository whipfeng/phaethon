# Example config.yaml for phaethon.
# On first run phaethon generates a config.yaml automatically; this file is only
# a reference for manual editing.

proxies:
  - name: EXAMPLE_PROXY
    type: socks5
    server: 127.0.0.1
    port: 1080
    udp: true

proxy-groups:
  - name: AUTO_GROUP
    type: select
    proxies:
      - EXAMPLE_PROXY

subscriptions: []

rules:
  - IP-CIDR,10.0.0.0/8,DIRECT
  - MATCH,EXAMPLE_PROXY

mappings:
  - name: local-socks5
    type: socks5
    port: 7890

resolvers: []

interactive: false
udp-port-range: ""
tcp-port-range: ""

admin:
  enabled: true
  addr: 127.0.0.1:9090
  token: ""
  auth-enabled: true
  username: ""
  password: ""

tun:
  enabled: false
