// ===== 反向配置 =====

// storeReverse 清零反向配置的运行时信息字段。
func storeReverse(rc *config.ReverseConfig) *config.ReverseConfig {
	c := *rc
	c.LastError = ""
	c.AssignedPort = 0
	return &c
}

func PutReverseConfig(rc *config.ReverseConfig) error {
	return Put(BucketReverseConfs, []byte(rc.Name), storeReverse(rc))
}

func GetReverseConfig(name string) (*config.ReverseConfig, error) {
	return getView[config.ReverseConfig](BucketReverseConfs, []byte(name))
}

func DeleteReverseConfig(name string) error {
	return Delete(BucketReverseConfs, []byte(name))
}

func ListReverseConfigs() ([]*config.ReverseConfig, error) {
	return listView[config.ReverseConfig](BucketReverseConfs)
}

// ===== 规则 =====

// rulesKey 是存储所有规则的单一 key（JSON 数组格式）
var rulesKey = []byte("__all_rules__")

// PutRules 替换整个规则列表（原子操作）
func PutRules(rules []string) error {
	err := Update(func(tx *bolt.Tx) error {
		b := tx.Bucket(BucketRules)
		if b == nil {
			return fmt.Errorf("bucket %s 不存在", string(BucketRules))
		}
		return putJSON(b, rulesKey, rules)
	})
	if err != nil {
		return err
	}
	notifyChanges([]ChangeEvent{{
		Bucket: string(BucketRules), Key: KeyRebuilt, Op: OpPut,
	}})
	return nil
}

// ListRules 返回所有规则
func ListRules() ([]string, error) {
	var rules []string
	err := View(func(tx *bolt.Tx) error {
		b := tx.Bucket(BucketRules)
		if b == nil {
			return nil
		}
		data := b.Get(rulesKey)
		if data == nil {
			// 兼容旧格式：尝试读取索引式规则
			var legacyRules []string
			_ = b.ForEach(func(k, v []byte) error {
				if string(k) == string(rulesKey) {
					return nil
				}
				var r string
				if err := json.Unmarshal(v, &r); err == nil {
					legacyRules = append(legacyRules, r)
				}
				return nil
			})
			if len(legacyRules) > 0 {
				rules = legacyRules
				return nil
			}
			return nil
		}
		return json.Unmarshal(data, &rules)
	})
	return rules, err
}

// InsertRule 在指定位置插入规则
func InsertRule(index int, rule string) error {
	err := Update(func(tx *bolt.Tx) error {
		b := tx.Bucket(BucketRules)
		if b == nil {
			return fmt.Errorf("bucket %s 不存在", string(BucketRules))
		}
		
		var rules []string
		data := b.Get(rulesKey)
		if data != nil {
			if err := json.Unmarshal(data, &rules); err != nil {
				return err
			}
		}
		
		if index < 0 || index > len(rules) {
			return fmt.Errorf("invalid index %d (rules count: %d)", index, len(rules))
		}
		
		rules = append(rules[:index], append([]string{rule}, rules[index:]...)...)
		return putJSON(b, rulesKey, rules)
	})
	if err != nil {
		return err
	}
	notifyChanges([]ChangeEvent{{
		Bucket: string(BucketRules), Key: KeyRebuilt, Op: OpPut,
	}})
	return nil
}

// DeleteRuleByIndex 删除指定位置的规则
func DeleteRuleByIndex(index int) error {
	err := Update(func(tx *bolt.Tx) error {
		b := tx.Bucket(BucketRules)
		if b == nil {
			return fmt.Errorf("bucket %s 不存在", string(BucketRules))
		}
		
		var rules []string
		data := b.Get(rulesKey)
		if data == nil {
			return fmt.Errorf("no rules found")
		}
		if err := json.Unmarshal(data, &rules); err != nil {
			return err
		}
		
		if index < 0 || index >= len(rules) {
			return fmt.Errorf("invalid index %d (rules count: %d)", index, len(rules))
		}
		
		rules = append(rules[:index], rules[index+1:]...)
		return putJSON(b, rulesKey, rules)
	})
	if err != nil {
		return err
	}
	notifyChanges([]ChangeEvent{{
		Bucket: string(BucketRules), Key: KeyRebuilt, Op: OpPut,
	}})
	return nil
}

// PutRule 在指定位置设置规则（用于更新单个规则）
func PutRule(index int, rule string) error {
	err := Update(func(tx *bolt.Tx) error {
		b := tx.Bucket(BucketRules)
		if b == nil {
			return fmt.Errorf("bucket %s 不存在", string(BucketRules))
		}
		
		var rules []string
		data := b.Get(rulesKey)
		if data != nil {
			if err := json.Unmarshal(data, &rules); err != nil {
				return err
			}
		}
		
		if index < 0 || index >= len(rules) {
			return fmt.Errorf("invalid index %d (rules count: %d)", index, len(rules))
		}
		
		rules[index] = rule
		return putJSON(b, rulesKey, rules)
	})
	if err != nil {
		return err
	}
	notifyChanges([]ChangeEvent{{
		Bucket: string(BucketRules), Key: KeyRebuilt, Op: OpPut,
	}})
	return nil
}

// DeleteRule 删除指定位置的规则（DeleteRuleByIndex 的别名）
func DeleteRule(index int) error {
	return DeleteRuleByIndex(index)
}

// listRulesTx 在事务内读取所有规则（供 LoadConf 使用）
func listRulesTx(tx *bolt.Tx) ([]string, error) {
	b := tx.Bucket(BucketRules)
	if b == nil {
		return nil, nil
	}
	data := b.Get(rulesKey)
	if data == nil {
		// 兼容旧格式
		var rules []string
		_ = b.ForEach(func(k, v []byte) error {
			if string(k) == string(rulesKey) {
				return nil
			}
			var r string
			if err := json.Unmarshal(v, &r); err == nil {
				rules = append(rules, r)
			}
			return nil
		})
		return rules, nil
	}
	var rules []string
	if err := json.Unmarshal(data, &rules); err != nil {
		return nil, err
	}
	return rules, nil
}

// readScalarInto 读取标量配置节。key 不存在返回 (false, nil) 且不改 dest。
func readScalarInto(cb *bolt.Bucket, key []byte, dest interface{}) (bool, error) {
	data := cb.Get(key)
	if data == nil {
		return false, nil
	}
	if err := json.Unmarshal(data, dest); err != nil {
		return true, fmt.Errorf("解析 %s 失败: %w", key, err)
	}
	return true, nil
}

// MigrateProxyGroups updates existing proxy groups with proxies from the config.
// This fixes the issue where old migrations only stored ManualProxies but not Proxies.
func MigrateProxyGroups(conf *config.RuleConfiguration) error {
	return Update(func(tx *bolt.Tx) error {
		gb := tx.Bucket(BucketProxyGroups)
		if gb == nil {
			return nil
		}

		for _, g := range conf.ProxyGroups {
			if g == nil {
				continue
			}
			// Read existing group from DB
			data := gb.Get([]byte(g.Name))
			if data == nil {
				continue
			}
			var existing config.ProxyGroup
			if err := json.Unmarshal(data, &existing); err != nil {
				continue
			}

			// If ManualProxies is empty but config has Proxies, update it
			if len(existing.ManualProxies) == 0 && len(g.Proxies) > 0 {
				existing.ManualProxies = append([]string(nil), g.Proxies...)
				if err := putJSON(gb, []byte(g.Name), &existing); err != nil {
					return err
				}
			}
		}
		return nil
	})
}

// ResetConfigPreserving has been removed. Use ReplaceAllConfig with preserved values instead.
// See admin/admin.go config reset handler for example usage.

// IsEmptyConfig 报告配置 bucket 是否全部为空。数据库文件存在但从未写入
// 配置时（如初始化中断），主流程仍需走导入流程。
func IsEmptyConfig() (bool, error) {
	empty := true
	err := View(func(tx *bolt.Tx) error {
		for _, bucket := range configBuckets() {
			b := tx.Bucket(bucket)
			if b == nil {
				continue
			}
			if b.Stats().KeyN > 0 {
				empty = false
				return nil
			}
		}
		return nil
	})
	return empty, err
}

// StartupConf holds the minimal configuration needed at startup.
type StartupConf struct {
	Subscriptions  []*config.Subscription
	ProxyGroups    []*config.ProxyGroup
	ReverseConfigs []*config.ReverseConfig
}

// LoadStartupConf loads the minimal configuration needed at startup.
// This is used for one-time initialization (e.g., loading subscription caches,
// normalizing reverse configs). For runtime rule matching, use RuleMatcher instead.
func LoadStartupConf() (*StartupConf, error) {
	conf := &StartupConf{}
	err := View(func(tx *bolt.Tx) error {
		var err error
		if conf.Subscriptions, err = listTx[config.Subscription](tx, BucketSubscriptions); err != nil {
			return err
		}
		if conf.ProxyGroups, err = listTx[config.ProxyGroup](tx, BucketProxyGroups); err != nil {
			return err
		}
		if conf.ReverseConfigs, err = listTx[config.ReverseConfig](tx, BucketReverseConfs); err != nil {
			return err
		}
		return nil
	})
	if err != nil {
		return nil, err
	}
	return conf, nil
}

// LoadRuleConfiguration loads the full rule configuration for service initialization.
// This is used at startup and reload to initialize services (run(), ControlManager, etc.).
// For runtime rule matching, use RuleMatcher instead (which reads from DB in real-time).
func LoadRuleConfiguration() (*config.RuleConfiguration, error) {
	conf := &config.RuleConfiguration{}
	err := View(func(tx *bolt.Tx) error {
		var err error
		if conf.Proxies, err = listTx[config.Proxy](tx, BucketProxies); err != nil {
			return err
		}
		if conf.ProxyGroups, err = listTx[config.ProxyGroup](tx, BucketProxyGroups); err != nil {
			return err
		}
		if conf.Subscriptions, err = listTx[config.Subscription](tx, BucketSubscriptions); err != nil {
			return err
		}
		if conf.Rules, err = listRulesTx(tx); err != nil {
			return err
		}
		if conf.Mappings, err = listTx[config.Mapping](tx, BucketMappings); err != nil {
			return err
		}
		if conf.Resolvers, err = listTx[config.Resolver](tx, BucketResolvers); err != nil {
			return err
		}
		if conf.ReverseConfigs, err = listTx[config.ReverseConfig](tx, BucketReverseConfs); err != nil {
			return err
		}

		cb := tx.Bucket(BucketConfig)

		var admin config.AdminConfig
		if present, err := readScalarInto(cb, keyAdmin, &admin); err != nil {
			return err
		} else if present {
			conf.Admin = &admin
		}

		var tun config.TUNConfig
		if present, err := readScalarInto(cb, keyTUN, &tun); err != nil {
			return err
		} else if present {
			conf.TUN = &tun
		}

		var mesh config.MeshConfig
		if present, err := readScalarInto(cb, keyMesh, &mesh); err != nil {
			return err
		} else if present {
			conf.Mesh = &mesh
		}

		if _, err := readScalarInto(cb, keyInteractive, &conf.Interactive); err != nil {
			return err
		}
		if _, err := readScalarInto(cb, keyUDPPortRange, &conf.UDPPortRange); err != nil {
			return err
		}
		if _, err := readScalarInto(cb, keyTCPPortRange, &conf.TCPPortRange); err != nil {
			return err
		}
		return nil
	})
	if err != nil {
		return nil, err
	}

	if err := conf.Init(); err != nil {
		return nil, fmt.Errorf("config init: %w", err)
	}
	return conf, nil
}
