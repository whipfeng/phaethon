package main

import (
	"database/sql"
	"encoding/json"
	"fmt"
	"os"

	_ "modernc.org/sqlite"
)

type AdminConfig struct {
	AuthEnabled bool   `json:"authEnabled"`
	Password    string `json:"password"`
}

type Config struct {
	Admin *AdminConfig `json:"admin,omitempty"`
}

func main() {
	if len(os.Args) < 2 {
		fmt.Println("Usage: reset-password <db-path>")
		os.Exit(1)
	}

	dbPath := os.Args[1]

	db, err := sql.Open("sqlite", dbPath)
	if err != nil {
		fmt.Fprintf(os.Stderr, "Failed to open database: %v\n", err)
		os.Exit(1)
	}
	defer db.Close()

	var value string
	err = db.QueryRow("SELECT value FROM config WHERE key='admin_config'").Scan(&value)
	if err != nil {
		fmt.Fprintf(os.Stderr, "Failed to query admin_config: %v\n", err)
		os.Exit(1)
	}

	fmt.Printf("Current config: %s\n", value)

	var config Config
	if err := json.Unmarshal([]byte(value), &config); err != nil {
		fmt.Fprintf(os.Stderr, "Failed to parse JSON: %v\n", err)
		os.Exit(1)
	}

	if config.Admin == nil {
		config.Admin = &AdminConfig{}
	}

	newPassword := "admin123"
	config.Admin.Password = newPassword
	config.Admin.AuthEnabled = true

	newValue, err := json.Marshal(config)
	if err != nil {
		fmt.Fprintf(os.Stderr, "Failed to marshal JSON: %v\n", err)
		os.Exit(1)
	}

	_, err = db.Exec("UPDATE config SET value=? WHERE key='admin_config'", string(newValue))
	if err != nil {
		fmt.Fprintf(os.Stderr, "Failed to update: %v\n", err)
		os.Exit(1)
	}

	fmt.Printf("✓ Password updated to: %s\n", newPassword)
}
